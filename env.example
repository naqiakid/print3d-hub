# Supabase — find these in your project's API settings
# https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API key — enables house-level address autocomplete (optional)
# Without this, falls back to OpenStreetMap (street-level only in Malaysia)
# Get one at: https://console.cloud.google.com → APIs & Services → Enable "Places API"
GOOGLE_MAPS_API_KEY=

# Slicer service — Render.com deployment URL (optional, falls back to size estimate)
# https://your-service-name.onrender.com
SLICER_SERVICE_URL=
